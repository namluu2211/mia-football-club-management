// Generated by scripts/generate-firebase-rules.js. Do not edit by hand.
rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email.lower() in ['bktientu@gmail.com', 'nguyenthuysy@gmail.com', 'hanguyen@thanglongfc.com', 'hieutran@thanglongfc.com'];
    }

    // Player media: public read, admin-only write, videos capped at 50 MB.
    match /players/{playerId}/videos/{fileName} {
      allow read: if true;
      allow write: if isAdmin()
        && request.resource.size < 52428800
        && request.resource.contentType.matches('video/.*');
      allow delete: if isAdmin();
    }

    // Everything else is closed.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
